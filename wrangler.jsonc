{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gratus1",
  "main": "worker.js",
  "compatibility_date": "2026-05-31",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "FEED_KV",
      "id": "7997119d31dc4863b245ca8019cbf6db"
    }
  ]
}
